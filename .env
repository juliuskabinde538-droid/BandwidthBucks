# ==========================================================
# Global defaults (affect ALL containers)
# ==========================================================
# RESTART_MODE controls how Docker restarts containers:
#   - always   → container restarts automatically if it stops
#   - unless-stopped → restart unless you manually stop it
#   - no       → never restart automatically
RESTART_MODE=always

# SHM_SIZE sets the shared memory size inside containers.
#   Default 2g is usually fine. Increase if apps complain.
SHM_SIZE=2g

# LOG controls Docker logging:
#   - ENABLED  → logs are stored (can fill disk if left unchecked)
#   - DISABLED → no logs (saves disk space, less debugging info)
LOG=DISABLED

# ==========================================================
# PROXY mode
# ==========================================================
# This controls whether apps run directly on your network
# or through one or more proxies defined in proxy.txt.
#
#   - ENABLED  → apps run through tun2socks using proxy.txt
#   - DISABLED → apps run directly on your network
#
# If you ENABLE this, you MUST create a file called proxy.txt
# in the same folder as this script. Each line in proxy.txt
# should contain ONE proxy URL in one of the following formats:
#
#   http://host:port
#   http://[username:password@]hostname:port
#   socks4://hostname:port
#   socks4://[username@]hostname:port
#   socks5://host:port
#   socks5://[username:password@]hostname:port
#
# Notes:
#   • "username:password@" is optional if your proxy doesn’t need auth.
#   • host can be an IP (e.g. 123.45.67.89) or a domain (e.g. proxy.example.com).
#   • port is required (e.g. 1080, 8080, etc.).
#   • Blank lines or lines not matching the above formats are ignored.
#   • If you list multiple proxies, the script will spin up one tun2socks
#     container per proxy and suffix app containers with counters (_00001, _00002).
#
PROXY=DISABLED

# ==========================================================
# App toggles and credentials
# ==========================================================
# Each app has two parts:
#   1. app_X=ENABLED or DISABLED → turn the app on/off
#   2. var_X_* → your AppKey, Token, Email, Password or API_key for that app
#
# If you don’t want to run an app, set app_X=DISABLED.
# If you ENABLE it, make sure to uncomment the var_ and enter the correct credentials.
# ==========================================================

RESTART_MODE=always
SHM_SIZE=2g
LOG=DISABLED
PROXY=DISABLED

HONEYGAIN=ENABLED
HONEYGAIN_EMAIL=juliuskabinde538@gmail.com
